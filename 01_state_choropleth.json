{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 330,
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#476056",
      "titleColor": "#23382c",
      "gridColor": "#e4e9e1",
      "labelFont": "Inter",
      "titleFont": "Inter"
    },
    "legend": {
      "labelColor": "#30493b",
      "titleColor": "#30493b"
    }
  },
  "title": {
    "text": "Species names recorded by state",
    "subtitle": "Choose an insect order; counts reflect records in the ALA export."
  },
  "params": [
    {
      "name": "selectedGroup",
      "value": "Lepidoptera",
      "bind": {
        "input": "select",
        "options": [
          "Lepidoptera",
          "Hymenoptera",
          "Odonata"
        ]
      }
    }
  ],
  "projection": {
    "type": "mercator",
    "center": [
      134,
      -26
    ],
    "scale": 640
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.min.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "calculate": "datum.properties.STATE_NAME || datum.properties.name || datum.properties.STATE || datum.properties.state || datum.properties.NAME",
          "as": "state_name"
        },
        {
          "calculate": "datum.state_name + '|' + selectedGroup",
          "as": "joinKey"
        },
        {
          "lookup": "joinKey",
          "from": {
            "data": {
              "url": "data/state_group.csv"
            },
            "key": "key",
            "fields": [
              "species",
              "records"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "field": "species",
          "type": "quantitative",
          "scale": {
            "scheme": "tealblues"
          },
          "title": "Recorded species"
        },
        "tooltip": [
          {
            "field": "state_name",
            "title": "State"
          },
          {
            "field": "species",
            "title": "Species-level names"
          },
          {
            "field": "records",
            "title": "Observations"
          }
        ]
      }
    }
  ]
}