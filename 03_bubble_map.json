{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 370,
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#476056",
      "titleColor": "#23382c",
      "gridColor": "#e4e9e1",
      "labelFont": "Inter",
      "titleFont": "Inter"
    },
    "legend": {
      "labelColor": "#30493b",
      "titleColor": "#30493b"
    }
  },
  "title": {
    "text": "Observation totals by state",
    "subtitle": "Circle area represents number of records; symbols located at approximate state centres."
  },
  "projection": {
    "type": "mercator",
    "center": [
      134,
      -26
    ],
    "scale": 640
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.min.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eef2eb",
        "stroke": "#c5d1ca",
        "strokeWidth": 0.7
      }
    },
    {
      "data": {
        "url": "data/state_group.csv"
      },
      "params": [
        {
          "name": "bubbleGroup",
          "value": "Lepidoptera",
          "bind": {
            "input": "select",
            "options": [
              "Lepidoptera",
              "Hymenoptera",
              "Odonata"
            ]
          }
        }
      ],
      "transform": [
        {
          "filter": "datum.group === bubbleGroup"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#e0a148",
        "stroke": "#855b21",
        "strokeWidth": 1,
        "opacity": 0.65
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "records",
          "type": "quantitative",
          "scale": {
            "range": [
              50,
              3000
            ]
          },
          "legend": {
            "title": "Records"
          }
        },
        "tooltip": [
          {
            "field": "state_name",
            "title": "State"
          },
          {
            "field": "records",
            "title": "Records",
            "format": ","
          },
          {
            "field": "species",
            "title": "Distinct species names"
          }
        ]
      }
    }
  ]
}